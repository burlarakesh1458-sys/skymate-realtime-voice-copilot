# --- Groq (OpenAI-compatible). Get a key at https://console.groq.com/keys ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_ASR_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=openai/gpt-oss-20b
GROQ_LLM_REASONING_EFFORT=low
# Orpheus needs a one-time terms acceptance by the org admin in the Groq console playground
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy

# --- Provider chains (ordered; first = primary, rest = fallbacks) ---
# asr: groq | faster_whisper | deepgram | mock
# llm: groq | groq:<model-id> | degraded | mock
# tts: groq | piper | elevenlabs | cartesia | mock
ASR_CHAIN=groq,faster_whisper
LLM_CHAIN=groq,degraded
TTS_CHAIN=groq,piper

# --- Local fallbacks ---
FASTER_WHISPER_MODEL=tiny.en
PIPER_MODEL_PATH=models/piper/en_US-lessac-low.onnx
WARMUP_LOCAL=true

# --- Optional vendors (untested adapters; leave blank to skip) ---
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
CARTESIA_API_KEY=

PERSONA=drone_ops
CHUNK_MODE=eager

# --- Resilience ---
ASR_TIMEOUT_S=8
LLM_TTFT_TIMEOUT_S=4
LLM_TOTAL_TIMEOUT_S=25
TTS_TIMEOUT_S=8
RETRY_ATTEMPTS=2
BREAKER_FAILURE_THRESHOLD=3
BREAKER_COOLDOWN_S=30
ACK_AFTER_S=1.5

# --- Fault injection (demo / regression only) ---
FAULT_ASR_DOWN=false
FAULT_LLM_TIMEOUT=false
FAULT_LLM_SLOW_MS=0
FAULT_TTS_DOWN=false
FAULT_ERROR_RATE=0
ALLOW_CLIENT_FAULTS=false

# --- Ops ---
RECORD_AUDIO_DIR=
METRICS_DB=reports/metrics.sqlite
METRICS_JSONL=reports/metrics.jsonl
